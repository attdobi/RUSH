{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUSH FlipRateRecord",
  "description": "Per image/model label stability across repeated labeling runs.",
  "type": "object",
  "required": [
    "image_id",
    "model_id",
    "n_runs",
    "labels_observed",
    "label_counts",
    "distinct_label_count",
    "flip_count",
    "flip_rate",
    "stable_label",
    "abstain_count",
    "confidence_min",
    "confidence_max",
    "confidence_mean",
    "first_seen_run_id",
    "last_seen_run_id"
  ],
  "properties": {
    "image_id": { "type": "string" },
    "model_id": { "type": "string" },
    "n_runs": { "type": "integer", "minimum": 0 },
    "labels_observed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "label_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "distinct_label_count": { "type": "integer", "minimum": 0 },
    "flip_count": { "type": "integer", "minimum": 0 },
    "flip_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "stable_label": { "type": ["string", "null"] },
    "abstain_count": { "type": "integer", "minimum": 0 },
    "confidence_min": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "confidence_max": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "confidence_mean": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "first_seen_run_id": { "type": "string" },
    "last_seen_run_id": { "type": "string" }
  }
}
