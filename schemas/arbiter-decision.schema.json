{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUSH ArbiterDecision",
  "type": "object",
  "required": [
    "arbiter_run_id",
    "image_id",
    "final_label",
    "final_placements",
    "difficulty_tier",
    "consensus_status",
    "reconciliation_method",
    "per_labeler_votes",
    "policy_graph_version"
  ],
  "properties": {
    "arbiter_run_id": {"type": "string"},
    "image_id": {"type": "string"},
    "final_label": {
      "enum": ["gen_ai", "not_gen_ai", "abstain"]
    },
    "final_placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "weight"],
        "properties": {
          "node_id": {"type": "string"},
          "weight": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "difficulty_tier": {
      "enum": ["easy", "medium", "hard", "sme-misalignment"]
    },
    "consensus_status": {
      "enum": ["unanimous", "two_of_three", "no_majority"]
    },
    "reconciliation_method": {"type": "string"},
    "per_labeler_votes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["labeler_id", "label", "placements", "confidence"],
        "properties": {
          "labeler_id": {"type": "string"},
          "label": {"enum": ["gen_ai", "not_gen_ai", "abstain"]},
          "placements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["node_id", "weight"],
              "properties": {
                "node_id": {"type": "string"},
                "weight": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "additionalProperties": false
            }
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "policy_graph_version": {"type": "string"}
  },
  "additionalProperties": false
}
