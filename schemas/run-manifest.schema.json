{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUSH RunManifest",
  "$comment": "Per-run manifest for a bulk-labeling pass. Written once at run start (finished_at=null), then rewritten atomically when the run completes.",
  "type": "object",
  "required": [
    "run_id",
    "started_at",
    "finished_at",
    "sample_manifest_path",
    "sample_ids",
    "models",
    "policy_graph_version",
    "prompt_version",
    "sampling_version"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}-[a-f0-9]{8}$",
      "description": "UTC timestamp + short uuid: YYYYMMDDTHHMMSS-xxxxxxxx"
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {
      "type": "string",
      "enum": ["running", "completed", "aborted", "failed"],
      "description": "Optional run lifecycle status. Legacy manifests may omit this."
    },
    "abort_reason": {
      "type": "string",
      "description": "Human-readable reason set when status=aborted or status=failed."
    },
    "completed_with_errors": {
      "type": "boolean",
      "description": "True when the pass completed with usable labels while some per-image calls failed."
    },
    "sample_manifest_path": {
      "type": "string",
      "description": "Repo-relative path to the source manifest, e.g. data/images/genai-classification/manifests/combined_labels.jsonl"
    },
    "sample_ids": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "Sorted list of sample_ids included in this run."
    },
    "model_runtime_config": {
      "type": "object",
      "description": "Per-model provider runtime knobs used for auditability.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "reasoning_effort": {"type": "string", "enum": ["none", "minimal", "low", "medium", "high", "xhigh"]},
          "thinking_budget_tokens": {"type": "integer"}
        },
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["model_id"],
        "properties": {
          "model_id": {"type": "string"},
          "phase": {"type": "string"},
          "params": {"type": "object"},
          "resolved_temperature": {"type": ["number", "null"]}
        },
        "additionalProperties": false
      }
    },
    "area": {
      "type": "string",
      "enum": ["Generative_AI", "MNIST_Digits"],
      "description": "Policy/demo area that selected the provider ontology for this run."
    },
    "policy_version": {
      "type": "string",
      "description": "Bare policy graph version directory selected in the UI, e.g. v0.1."
    },
    "policy_graph_version": {"type": "string"},
    "prompt_version": {"type": "string"},
    "sampling_version": {"type": "string"},
    "split": {
      "type": "string",
      "description": "Split selector used at dispatch time (e.g. dev_golden, holdout, all)."
    },
    "limit": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Optional max sample count for the run."
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "description": "In-flight provider call cap per provider."
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Requested maximum images per logical provider batch."
    },
    "effective_batches": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of logical provider batches scheduled for the run."
    },
    "image_prep": {
      "type": "object",
      "required": ["longest_edge_px", "format", "quality"],
      "properties": {
        "longest_edge_px": {"type": "integer", "minimum": 1},
        "format": {"type": "string"},
        "quality": {"type": "integer", "minimum": 1, "maximum": 100},
        "helper_module": {
          "type": "string",
          "description": "Module path to the shared helper, e.g. pipeline.labeling.image_prep"
        }
      },
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "required": ["expected_calls"],
      "properties": {
        "expected_calls": {"type": "integer", "minimum": 0},
        "completed_calls": {"type": "integer", "minimum": 0},
        "errored_calls": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "per_model_timing": {
      "type": "object",
      "description": "Per-model timing/token/cost rollup derived from completed call timestamps. images_per_min uses each model's own active window, so finished model rates freeze while other models continue.",
      "required": ["per_model", "total"],
      "properties": {
        "per_model": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "model",
              "model_id",
              "n_calls",
              "calls_done",
              "total_input_tokens",
              "total_output_tokens",
              "total_cost_usd",
              "total_cost",
              "first_started_at",
              "last_finished_at",
              "active_elapsed_s",
              "avg_s_per_call",
              "avg_latency_ms",
              "tokens_per_sec",
              "images_per_min",
              "throughput_imgs_per_min"
            ],
            "properties": {
              "model": {"type": "string"},
              "model_id": {"type": "string"},
              "n_calls": {"type": "integer", "minimum": 0},
              "calls_done": {"type": "integer", "minimum": 0},
              "total_input_tokens": {"type": "integer", "minimum": 0},
              "total_output_tokens": {"type": "integer", "minimum": 0},
              "total_cached_input_tokens": {"type": "integer", "minimum": 0},
              "total_cache_write_tokens": {"type": "integer", "minimum": 0},
              "total_tokens": {"type": "integer", "minimum": 0},
              "total_cost_usd": {"type": "number", "minimum": 0},
              "total_cost": {"type": "number", "minimum": 0},
              "first_started_at": {"type": ["string", "null"], "format": "date-time"},
              "last_finished_at": {"type": ["string", "null"], "format": "date-time"},
              "active_elapsed_s": {"type": ["number", "null"], "minimum": 0},
              "avg_s_per_call": {"type": ["number", "null"], "minimum": 0},
              "avg_latency_ms": {"type": ["number", "null"], "minimum": 0},
              "tokens_per_sec": {"type": ["number", "null"], "minimum": 0},
              "images_per_min": {"type": ["number", "null"], "minimum": 0},
              "throughput_imgs_per_min": {"type": ["number", "null"], "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "total": {
          "type": "object",
          "required": [
            "calls_done",
            "n_calls",
            "total_input_tokens",
            "total_output_tokens",
            "total_cost_usd",
            "total_cost",
            "first_started_at",
            "last_finished_at",
            "active_elapsed_s",
            "images_per_min",
            "tokens_per_sec"
          ],
          "properties": {
            "calls_done": {"type": "integer", "minimum": 0},
            "n_calls": {"type": "integer", "minimum": 0},
            "total_input_tokens": {"type": "integer", "minimum": 0},
            "total_output_tokens": {"type": "integer", "minimum": 0},
            "total_cached_input_tokens": {"type": "integer", "minimum": 0},
            "total_cache_write_tokens": {"type": "integer", "minimum": 0},
            "total_tokens": {"type": "integer", "minimum": 0},
            "total_cost_usd": {"type": "number", "minimum": 0},
            "total_cost": {"type": "number", "minimum": 0},
            "first_started_at": {"type": ["string", "null"], "format": "date-time"},
            "last_finished_at": {"type": ["string", "null"], "format": "date-time"},
            "active_elapsed_s": {"type": ["number", "null"], "minimum": 0},
            "images_per_min": {"type": ["number", "null"], "minimum": 0},
            "tokens_per_sec": {"type": ["number", "null"], "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "description": "Per-batch + per-image cost ledger recorded at run finalization. Local models are $0; unknown-pricing batches carry null cost_usd.",
      "required": ["total_cost_usd", "per_batch"],
      "properties": {
        "total_cost_usd": {"type": "number", "minimum": 0},
        "cost_per_image_usd": {"type": ["number", "null"], "minimum": 0},
        "priced_images": {"type": "integer", "minimum": 0},
        "batches_with_unknown_cost": {"type": "integer", "minimum": 0},
        "per_batch": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["batch_index", "model_id", "images", "cost_usd"],
            "properties": {
              "batch_index": {"type": "integer", "minimum": 0},
              "model_id": {"type": "string"},
              "images": {"type": "integer", "minimum": 0},
              "cost_usd": {"type": ["number", "null"], "minimum": 0},
              "cost_per_image_usd": {"type": ["number", "null"], "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "per_model": {
          "type": "object",
          "description": "Per-LLM cost breakdown recomputed from the LIVE pricing registry at finalization.",
          "additionalProperties": {"type": "object"}
        },
        "pricing_version": {"type": "string", "description": "Pricing registry version used to compute this run's ledger."},
        "pricing_versions_present": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Distinct pricing_version stamps present in the durable ledger rows (mixed => legacy rows present)."
        }
      },
      "additionalProperties": false
    },
    "dry_run": {
      "type": "boolean",
      "description": "True if the run was executed with a deterministic fake client (no real provider calls)."
    }
  },
  "additionalProperties": false
}
