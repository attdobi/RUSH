{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUSH RunManifest",
  "$comment": "Per-run manifest for a bulk-labeling pass. Written once at run start (finished_at=null), then rewritten atomically when the run completes.",
  "type": "object",
  "required": [
    "run_id",
    "started_at",
    "finished_at",
    "sample_manifest_path",
    "sample_ids",
    "models",
    "policy_graph_version",
    "prompt_version",
    "sampling_version"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}-[a-f0-9]{8}$",
      "description": "UTC timestamp + short uuid: YYYYMMDDTHHMMSS-xxxxxxxx"
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "sample_manifest_path": {
      "type": "string",
      "description": "Repo-relative path to the source manifest, e.g. data/images/genai-classification/manifests/combined_labels.jsonl"
    },
    "sample_ids": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "Sorted list of sample_ids included in this run."
    },
    "model_runtime_config": {
      "type": "object",
      "description": "Per-model provider runtime knobs used for auditability.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "reasoning_effort": {"type": "string", "enum": ["high", "xhigh"]},
          "thinking_budget_tokens": {"type": "integer"}
        },
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["model_id"],
        "properties": {
          "model_id": {"type": "string"},
          "phase": {"type": "string"},
          "params": {"type": "object"},
          "resolved_temperature": {"type": ["number", "null"]}
        },
        "additionalProperties": false
      }
    },
    "policy_graph_version": {"type": "string"},
    "prompt_version": {"type": "string"},
    "sampling_version": {"type": "string"},
    "split": {
      "type": "string",
      "description": "Split selector used at dispatch time (e.g. dev_golden, holdout, all)."
    },
    "limit": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Optional max sample count for the run."
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "description": "In-flight provider call cap per provider."
    },
    "image_prep": {
      "type": "object",
      "required": ["longest_edge_px", "format", "quality"],
      "properties": {
        "longest_edge_px": {"type": "integer", "minimum": 1},
        "format": {"type": "string"},
        "quality": {"type": "integer", "minimum": 1, "maximum": 100},
        "helper_module": {
          "type": "string",
          "description": "Module path to the shared helper, e.g. pipeline.labeling.image_prep"
        }
      },
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "required": ["expected_calls"],
      "properties": {
        "expected_calls": {"type": "integer", "minimum": 0},
        "completed_calls": {"type": "integer", "minimum": 0},
        "errored_calls": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "dry_run": {
      "type": "boolean",
      "description": "True if the run was executed with a deterministic fake client (no real provider calls)."
    }
  },
  "additionalProperties": false
}
