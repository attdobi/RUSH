{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUSH DecisionQualitySnapshot",
  "type": "object",
  "required": [
    "policy_graph_version",
    "ground_truth_tier",
    "labelers"
  ],
  "properties": {
    "policy_graph_version": {
      "type": "string"
    },
    "ground_truth_tier": {
      "type": "array",
      "items": {
        "enum": [
          "gold",
          "platinum"
        ]
      }
    },
    "labelers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/labeler_row"
      }
    },
    "by_split": {
      "type": "object",
      "required": [
        "train",
        "test"
      ],
      "properties": {
        "train": {
          "$ref": "#/$defs/split_block"
        },
        "test": {
          "$ref": "#/$defs/split_block"
        }
      },
      "additionalProperties": false
    },
    "reported_split": {
      "enum": [
        "test"
      ]
    },
    "reported": {
      "$ref": "#/$defs/split_block"
    },
    "update_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/update_candidate"
      }
    },
    "evolution": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "labeler_id",
          "metrics"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "labeler_id": {
            "type": "string"
          },
          "metrics": {
            "$ref": "#/$defs/decision_quality_metrics"
          }
        },
        "additionalProperties": false
      }
    },
    "warning": {
      "type": "string"
    },
    "cost": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "labeler_row": {
      "type": "object",
      "required": [
        "labeler_id",
        "labeler_type",
        "metrics"
      ],
      "properties": {
        "labeler_id": {
          "type": "string"
        },
        "labeler_type": {
          "enum": [
            "llm",
            "ensemble",
            "human"
          ]
        },
        "metrics": {
          "$ref": "#/$defs/decision_quality_metrics"
        }
      },
      "additionalProperties": false
    },
    "split_block": {
      "type": "object",
      "required": [
        "labelers",
        "n_images"
      ],
      "properties": {
        "labelers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/labeler_row"
          }
        },
        "n_images": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "update_candidate": {
      "type": "object",
      "required": [
        "image_id",
        "sme_truth",
        "misalignment_type",
        "severity",
        "split",
        "is_boundary",
        "repo_rel_path"
      ],
      "properties": {
        "image_id": {
          "type": "string"
        },
        "sme_truth": {
          "type": "string"
        },
        "misalignment_type": {
          "enum": [
            "consensus_wrong",
            "model_vs_sme",
            "model_vs_model"
          ]
        },
        "severity": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "split": {
          "enum": [
            "train"
          ]
        },
        "is_boundary": {
          "type": "boolean"
        },
        "repo_rel_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "decision_quality_metrics": {
      "type": "object",
      "required": [
        "accuracy",
        "f1",
        "precision",
        "recall",
        "fpr",
        "fnr",
        "positive_proportion",
        "n",
        "informedness"
      ],
      "properties": {
        "accuracy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "f1": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "precision": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "recall": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "fpr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "fnr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "positive_proportion": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "informedness": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "cost_per_1000_labels": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
