{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUSH DecisionQuality",
  "type": "object",
  "required": [
    "labeler_id",
    "labeler_type",
    "policy_graph_version",
    "ground_truth_source",
    "metrics",
    "timestamp"
  ],
  "properties": {
    "labeler_id": {"type": "string"},
    "labeler_type": {
      "enum": ["llm", "human", "majority_vote"]
    },
    "policy_graph_version": {"type": "string"},
    "ground_truth_source": {
      "enum": ["sme_latest"]
    },
    "metrics": {
      "type": "object",
      "required": [
        "accuracy",
        "f1",
        "precision",
        "recall",
        "fpr",
        "fnr",
        "positive_proportion",
        "n_images",
        "informedness"
      ],
      "properties": {
        "accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "f1": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "fpr": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "fnr": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "positive_proportion": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "n_images": {"type": "integer", "minimum": 0},
        "informedness": {"type": ["number", "null"], "minimum": -1, "maximum": 1}
      },
      "additionalProperties": false
    },
    "timestamp": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
