{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUSH LabelVote",
  "type": "object",
  "required": [
    "run_id",
    "image_id",
    "labeler_type",
    "label",
    "node_ids",
    "confidence",
    "justification",
    "policy_graph_version"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "image_id": {
      "type": "string"
    },
    "labeler_type": {
      "enum": [
        "llm",
        "human",
        "arbiter"
      ]
    },
    "labeler_id": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "label": {
      "enum": [
        "gen_ai",
        "not_gen_ai",
        "positive",
        "negative",
        "abstain"
      ]
    },
    "node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "justification": {
      "type": "string"
    },
    "policy_evidence": {
      "type": "array"
    },
    "uncertainty_reasons": {
      "type": "array"
    },
    "prompt_version": {
      "type": "string"
    },
    "policy_graph_version": {
      "type": "string"
    },
    "label_tier": {
      "enum": [
        "provisional",
        "silver",
        "gold",
        "platinum",
        "deprecated",
        "superseded"
      ]
    },
    "l0_label": {
      "enum": [
        "violative",
        "non_violative",
        "abstain"
      ]
    },
    "l2_label": {
      "type": "string"
    },
    "is_boundary": {
      "type": "boolean"
    },
    "is_boundary_between": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "description": "Optional boundary pair: exactly two L1 class ids when is_boundary=true for ontologies that require a pair (for example MNIST digit boundaries)."
    },
    "difficulty": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "prepared_image_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA256 of the downsampled JPEG bytes actually sent to the provider (see pipeline/labeling/image_prep.py)."
    },
    "prepared_image_width": {
      "type": "integer",
      "minimum": 1,
      "description": "Pixel width of the downsampled JPEG."
    },
    "prepared_image_height": {
      "type": "integer",
      "minimum": 1,
      "description": "Pixel height of the downsampled JPEG."
    },
    "prepared_image_mime_type": {
      "type": "string",
      "description": "MIME type of the downsampled bytes (typically image/jpeg)."
    },
    "prepared_image_byte_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Byte length of the downsampled JPEG payload."
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "End-to-end provider call latency including retries (X2 audit field)."
    },
    "attempts": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of provider call attempts (1 if no retry)."
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  }
}
