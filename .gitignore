# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv
.venv/
.env
.env.*
!.env.example

# Node
node_modules/
dist/
build/

# IDE/editor
.vscode/
.idea/

# Obsidian local workspace state
policy-graph/**/.obsidian/
policy-graph/**/*.canvas
policy-graph/Generative_AI/[0-9]*.md

# Dataset image bytes are local-only: track manifests, never image files.
# (docs/visuals/* architecture assets are intentionally NOT covered here.)
data/images/**/*.png
data/images/**/*.jpg
data/images/**/*.jpeg
data/images/**/*.webp
data/images/**/*.gif
!data/images/mnist-classification/mnist_full.npz
!data/images/genai-classification/sample/**/*.png
!data/images/genai-classification/sample/**/*.jpg
!data/images/genai-classification/sample/**/*.jpeg
!data/images/genai-classification/sample/**/*.JPEG
!data/images/genai-classification/sample/**/*.webp
!data/images/genai-classification/sample/**/*.gif

# Bulk-labeling run output (X2): per-run artifacts are not committed.
data/runs/

# Policy proposal staging (per-proposal verification artifacts).
data/policy_proposals/

# Attila's local notes drop-box for routing context between sessions.
.attila-notes/

# Built policy PDFs are build artifacts, not source.
*.pdf
!docs/**/*.pdf

# in-repo git worktrees (should never be committed)
/RUSH-wt-*

# SME re-adjudication actions are local runtime state, not committed demo data
data/adjudication_reviews.jsonl
