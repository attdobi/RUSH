# Image datasets are local/private by default.
# Commit only explicit per-project skeleton/docs/ignore files.
*
!.gitignore
!*/
!genai-classification/.gitignore
!genai-classification/README.md
!genai-classification/**/.gitkeep
!mnist-classification/.gitignore
!mnist-classification/README.md
!mnist-classification/**/.gitkeep
# MNIST manifests are deterministic + regenerable but committed for the demo.
!mnist-classification/manifests/*.csv
!mnist-classification/manifests/*.json
!mnist-classification/mnist_full.npz
!genai-classification/manifests/combined_labels.portable.jsonl
!genai-classification/sample/**/*.png
!genai-classification/sample/**/*.jpg
!genai-classification/sample/**/*.jpeg
!genai-classification/sample/**/*.JPEG
!genai-classification/sample/**/*.webp
!genai-classification/sample/**/*.gif
